{
  "name": "parley-server",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time AI interpreter call bridge: Telnyx phone calls + app-to-app calls, ElevenLabs STT/TTS/voice cloning, Claude translation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx --env-file=.env src/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^5.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
