# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in.  README.md explains where each value comes from.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys   (needs the $6/mo Starter plan or higher for voice cloning)
ELEVENLABS_API_KEY=
# https://console.anthropic.com/settings/keys   (used for translation)
ANTHROPIC_API_KEY=

# --- Required for phone calls (leave all four empty to test app-to-app + mirror only) -----------
# Public https URL of this server, e.g. from `ngrok http 8080`. No trailing slash.
PUBLIC_URL=
# Telnyx: API key (v2), the Voice API application ID ("connection id"), and your Telnyx phone number.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=+15551234567

# --- Optional -----------------------------------------------------------------
PORT=8080
# Voice used for the OTHER person when they have no cloned voice (e.g. the friend you phone).
# Browse voices in ElevenLabs > Voices, add one to "My voices", copy its ID.
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_MODEL=eleven_flash_v2_5
TRANSLATION_MODEL=claude-haiku-5-5
# Seconds of silence that end a sentence. Lower = faster but may interrupt slow speakers.
VAD_SILENCE_SECS=0.7

# --- Cost safety valves ------------------------------------------------------------
MAX_CALL_MINUTES=30
MAX_CONCURRENT_CALLS=5
PHONE_CALLS_PER_HOUR=10
# Only allow outbound calls to these country prefixes (comma separated). Empty = any.
# Example for Hungary + USA:  ALLOWED_DIAL_PREFIXES=+36,+1
ALLOWED_DIAL_PREFIXES=

# --- Advanced -----------------------------------------------------------------
MIN_VOICE_SECONDS=25
PACE_PHONE_AUDIO=true
DATA_DIR=./data
LOG_LEVEL=info
